{
  "mcpServers": {
    "defillama": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/connectors/defillama",
        "run",
        "python",
        "-m",
        "defillama_mcp.server"
      ]
    },
    "dune": {
      "type": "http",
      "url": "https://api.dune.com/mcp/v1",
      "headers": {
        "X-DUNE-API-KEY": "${DUNE_API_KEY}"
      }
    }
  }
}
